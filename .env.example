# ==============================================================================
# Competitor Finder SaaS - Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Plan Tier: "free" | "paid"
PLAN_TIER=free

# Database (PostgreSQL with pgvector)
# Async URL for FastAPI/asyncpg
DATABASE_URL=postgresql+asyncpg://compfinder:compfinder@localhost:5432/compfinder
# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://compfinder:compfinder@localhost:5432/compfinder

# Redis (Caching, Rate Limiting, arq Job Queue)
REDIS_URL=redis://localhost:6379/0

# Authentication (JWT)
JWT_SECRET=replace_with_a_secure_32_character_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Groq & Anthropic)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_ESCALATION_MODEL=llama-3.3-70b-versatile

# Anthropic (Optional alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest
ANTHROPIC_ESCALATION_MODEL=claude-3-7-sonnet-latest

# Search Providers
SERPAPI_KEY=your_serpapi_key_here
# Fallback Search API: Brave Search or Serper.dev
FALLBACK_SEARCH_API_KEY=your_fallback_search_api_key_here
FALLBACK_SEARCH_PROVIDER=brave

# Web Scraping / Extraction (Firecrawl)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Enrichment Provider (Apify - Paid Tier Only)
APIFY_TOKEN=your_apify_token_here
APIFY_GOOGLE_MAPS_ACTOR_ID=compass/crawler-google-places
APIFY_COMPANY_INFO_ACTOR_ID=apify/web-scraper

# Embeddings Configuration
# Options: "local" (open-source SentenceTransformers) | "openai" (paid external)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
OPENAI_API_KEY=optional_openai_key_if_using_openai_embeddings

# Frontend Public Variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
